# ==============================================================================
# CollabGrid - Backend Environment Configuration Template
# ==============================================================================
# Copy this file to `backend/.env` and adjust the values as needed.
# ==============================================================================

# Server Port (Default: 5000)
PORT=5000

# Frontend URL (Used for CORS and email verification links)
FRONTEND_URL=http://localhost:3000

# MongoDB Connection (Mongoose)
# Local MongoDB:
MONGO_URL=mongodb://127.0.0.1:27017/kanban_db
# Cloud MongoDB Atlas example:
# MONGO_URL=mongodb+srv://<username>:<password>@cluster.mongodb.net/kanban_db?retryWrites=true&w=majority
DB_NAME=kanban_db

# JWT (JSON Web Token) Security
# IMPORTANT: Replace with a strong, unpredictable random string in production
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=72

# Email Service (SendGrid) - Optional
# Required only if sending verification codes or password reset emails via SendGrid
SENDGRID_API_KEY=
FROM_EMAIL=no-reply@collabgrid.com
